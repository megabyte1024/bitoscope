if(NOT DEFINED OUT OR NOT DEFINED FUNCTION)
  message(FATAL_ERROR "embed_lua.cmake needs -DOUT=... and -DFUNCTION=...")
endif()

set(_files "")
if(DEFINED FILES AND NOT FILES STREQUAL "")
  string(REPLACE "|" ";" _files "${FILES}")
endif()

set(_body "// Generated by decoders/lua_gateway/embed_lua.cmake at build time. Do not edit.\n")
string(APPEND _body "#include <span>\n\n#include \"embedded_script.h\"\n\n")
set(_entries "")
set(_index 0)
foreach(_file IN LISTS _files)
  file(READ "${_file}" _hex HEX)
  string(LENGTH "${_hex}" _hex_length)
  math(EXPR _size "${_hex_length} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "'\\\\x\\1'," _bytes "${_hex}")
  string(REGEX REPLACE "(('\\\\x[0-9a-f][0-9a-f]',){16})" "\\1\n  " _bytes "${_bytes}")
  get_filename_component(_name "${_file}" NAME)
  string(APPEND _body "namespace {\nconstexpr char kScript${_index}[] = {\n  ${_bytes}'\\0'};\n}  // namespace\n\n")
  string(APPEND _entries "      {\"${_name}\", kScript${_index}, ${_size}},\n")
  math(EXPR _index "${_index} + 1")
endforeach()

string(APPEND _body "namespace bitoscope::lua_gateway {\n\n")
string(APPEND _body "std::span<const EmbeddedScript> ${FUNCTION}() {\n")
if(_index EQUAL 0)
  string(APPEND _body "  return {};\n")
else()
  string(APPEND _body "  static constexpr EmbeddedScript kScripts[] = {\n${_entries}  };\n  return kScripts;\n")
endif()
string(APPEND _body "}\n\n}  // namespace bitoscope::lua_gateway\n")

if(EXISTS "${OUT}")
  file(READ "${OUT}" _old)
  if(_old STREQUAL _body)
    return()
  endif()
endif()
file(WRITE "${OUT}" "${_body}")
