function(bitoscope_link_closure target out)
  set(_seen "")
  set(_todo ${target})
  while(_todo)
    list(POP_FRONT _todo _next)
    string(REGEX REPLACE "^\\$<LINK_ONLY:(.*)>$" "\\1" _next "${_next}")
    if(NOT TARGET ${_next} OR _next IN_LIST _seen)
      continue()
    endif()
    list(APPEND _seen ${_next})
    get_target_property(_type ${_next} TYPE)
    set(_properties INTERFACE_LINK_LIBRARIES)
    if(NOT _type STREQUAL "INTERFACE_LIBRARY")
      list(APPEND _properties LINK_LIBRARIES)
    endif()
    foreach(_property ${_properties})
      get_target_property(_libraries ${_next} ${_property})
      if(_libraries)
        list(APPEND _todo ${_libraries})
      endif()
    endforeach()
  endwhile()
  set(${out} ${_seen} PARENT_SCOPE)
endfunction()

function(bitoscope_forbid_links target pattern what)
  bitoscope_link_closure(${target} _closure)
  foreach(_linked ${_closure})
    if(_linked MATCHES "${pattern}")
      message(FATAL_ERROR
          "${target} links ${_linked}, ${what}. A driver's source holds no decoder code and a "
          "decoder's none of a driver's (cmake/BitoscopeAudience.cmake).")
    endif()
  endforeach()
endfunction()

set(_bitoscope_decoder_only "^bitoscope_(decode|decoder_.*|decoders_.*)$")
set(_bitoscope_driver_only "^bitoscope_driver_.*$")

foreach(_common bitoscope_plugin_c_sdk bitoscope_plugin_ipc bitoscope_plugin_ring bitoscope_capnp)
  bitoscope_forbid_links(${_common} "${_bitoscope_decoder_only}" "a decoder library, from a part every plugin shares")
  bitoscope_forbid_links(${_common} "${_bitoscope_driver_only}" "a driver library, from a part every plugin shares")
endforeach()
bitoscope_forbid_links(bitoscope_driver_c_sdk "${_bitoscope_decoder_only}" "a decoder library, from the driver SDK")
bitoscope_forbid_links(bitoscope_decoder_c_sdk "${_bitoscope_driver_only}" "a driver library, from the decoder SDK")
